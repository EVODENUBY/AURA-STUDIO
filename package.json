{
  "name": "aura-studio-root",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel backend frontend",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "seed": "npm --prefix backend run seed",
    "build": "npm-run-all build:frontend build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint": "npm-run-all lint:frontend lint:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
