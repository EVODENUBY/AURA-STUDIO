# Server Configuration
PORT=4000
HOST=0.0.0.0

# MongoDB Configuration
# Install MongoDB locally or use MongoDB Atlas:
#   Local:   mongodb://127.0.0.1:27017/aura_studio
#   Atlas:   mongodb+srv://<username>:<password>@cluster.mongodb.net/aura_studio
MONGODB_URI="mongodb://127.0.0.1:27017/aura_studio"

# Admin PIN Security (used to access AURA Studio Management Portal)
ADMIN_PIN=1234

# Gemini AI API Key (optional - for AI Lash & Tattoo Consultant)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Environment
NODE_ENV=development

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173
